# ==========================================
# Estágio 1: Build da aplicação Go
# ==========================================
FROM golang:1.21-alpine AS builder

WORKDIR /app

# Certificados CA para chamadas HTTPS/TLS e git
RUN apk add --no-cache ca-certificates git

# Copia todo o código fonte
COPY . .

# Corrige imports do código original no contêiner (troca "context" não utilizado por "os")
# e regenera go.sum sem alterar os arquivos do repositório local
RUN sed -i 's|"context"|"os"|' evaluator.go && \
    rm -f go.sum && \
    go mod tidy

# Compila o binário estático
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/evaluation-service .

# ==========================================
# Estágio 2: Imagem final enxuta de produção
# ==========================================
FROM alpine:3.19

WORKDIR /app

# Instala certificados, tzdata e cria usuário não-root
RUN apk --no-cache add ca-certificates tzdata && \
    addgroup -g 10001 appgroup && \
    adduser -u 10001 -G appgroup -s /bin/sh -D appuser

# Copia o binário estático
COPY --from=builder --chown=appuser:appgroup /app/evaluation-service /app/evaluation-service

USER appuser

EXPOSE 8004

ENTRYPOINT ["/app/evaluation-service"]
