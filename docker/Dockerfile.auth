# ==========================================
# Estágio 1: Build da aplicação Go
# ==========================================
FROM golang:1.21-alpine AS builder

WORKDIR /app

# Certificados CA para chamadas HTTPS/TLS
RUN apk add --no-cache ca-certificates

# Copia arquivos de dependência
COPY go.mod go.sum* ./
RUN sed -i '/github.com\/jackc\/pgx\/v4\/stdlib/d' go.mod && go mod download

# Copia o código fonte
COPY . .

# Corrige imports não utilizados e linha inválida no go.mod sem alterar o repositório original
RUN sed -i '/github.com\/jackc\/pgx\/v4\/stdlib/d' go.mod && \
    sed -i '/"crypto\/sha256"/d' handlers.go && \
    sed -i '/"encoding\/hex"/d' handlers.go && \
    sed -i '/"fmt"/d' key.go main.go && \
    sed -i 's|"github.com/jackc/pgx/v4/stdlib"|_ "github.com/jackc/pgx/v4/stdlib"|' main.go

# Compila o binário estático
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/auth-service .

# ==========================================
# Estágio 2: Imagem final enxuta de produção
# ==========================================
FROM alpine:3.19

WORKDIR /app

# Instala certificados, tzdata e cria usuário não-root
RUN apk --no-cache add ca-certificates tzdata && \
    addgroup -g 10001 appgroup && \
    adduser -u 10001 -G appgroup -s /bin/sh -D appuser

# Copia o binário estático
COPY --from=builder --chown=appuser:appgroup /app/auth-service /app/auth-service

USER appuser

EXPOSE 8001

ENTRYPOINT ["/app/auth-service"]
